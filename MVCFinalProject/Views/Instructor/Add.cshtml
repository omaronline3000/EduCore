@model AddingInstructorViewModel

<form method="post" action="/Instructor/SaveAdd">

    <label> Name </label>
    <input name="name" id="name" type="text" value="@Model.Name"/>
    <label> Salary </label>
    <input name="salary" id="salary" type="number" value="@Model.salary"/>
    <label> Address </label>
    <input name="address" id="address" type="text" value="@Model.Address"/>

    <label> Department </label>

    <select name="DepartmentId" onchange="GetCourses()" id="Departments">
        @foreach(var item in Model.departments)
            {
                if (item.Id == Model.DepartmentId)
                {
                <option value="@item.Id" selected>@item.Name</option>
                }
                else {
                    <option value="@item.Id">@item.Name</option>
                }
            }
            
    </select>

    <label> Course </label>
    
    <select name="CourseId" id="CourseId"> </select>

    <input type="submit" value="Add Instructor"/>

</form>

<script>
    $(document).ready(function() {
        GetCourses();
    });

    function GetCourses() {
        const selectedDeptId = document.getElementById("Departments").value;
        const courseDisplay = document.getElementById("CourseId");

        courseDisplay.innerHTML = "";
        $.ajax({
            url: "/Course/GetCoursesByDept?deptId=" + selectedDeptId,
            success: function(result) {
                result.forEach(item => {
                    courseDisplay.innerHTML +=
                        `<option value="${item.id}">${item.name}</option>`;
                });
            }
        });
    }
</script>
