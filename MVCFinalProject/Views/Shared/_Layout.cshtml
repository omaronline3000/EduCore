<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduCore </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCFinalProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <header>
        <partial name="_NavItems"></partial>
    </header>
    <section class="hero py-5 bg-light border-bottom">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="display-6">Learn. Build. Succeed.</h1>
                    <p class="lead mb-4">A lightweight interface to manage courses and instructors. Browse available courses or add new ones.</p>
                    <p>
                        <a class="btn btn-primary me-2" asp-controller="Course" asp-action="ShowAllCourses">Browse Courses</a>
                        <a class="btn btn-outline-secondary" asp-controller="Instructor" asp-action="ShowAll">Browse Instructors</a>
                    </p>
                </div>
                <div class="col-md-6 text-center">
                    <img src="~/assets/img/avataaars.svg" alt="hero" class="img-fluid hero-img" />
                </div>
            </div>
        </div>
    </section>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted flex-column">
        <div class="container">
            &copy; 2026 - MVCFinalProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
