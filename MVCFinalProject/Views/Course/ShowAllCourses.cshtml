@model List<Course>
@{
    ViewData["Title"] = "Courses";
}
<br />
<br />
<a asp-action="Add" asp-controller="Course" class="btn btn-primary">Add Course</a>
<br />
<br />
<table class="table table-bordered table-hover">

    <thead>
        <td>Id</td>
        <td>Name</td>
        <td>Degree</td>
        <td>minDegree</td>
        <td>Hourse</td>
        <td>Department</td>
        <td>Instructors</td>
    </thead>

    @foreach (var item in Model)
    {
        
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Degree</td>
            <td>@item.minDegree</td>
            <td>@item.Hourse</td>
            <td>@item.department?.Name</td>
            <td>
                <ol>
            @foreach (var instructor in item.instructors)
            {
                 
               <li>@instructor?.Name</li>
                 
            }
                </ol>
            </td>

            <td> <a 
                asp-action="Delete" 
                asp-controller="Course" 
                asp-route-id="@item.Id"
                onclick="return confirm('Are you sure ?');"
                class="btn btn-danger">Delete</a>
            </td>

        </tr>
    }
</table>
<br />
@{
    int prevnum = ViewBag.Num - 1 < 0 ? 0 : ViewBag.Num - 1;
    int nextnum = ViewBag.Num + 1;
}
<a asp-action="Index" 
asp-controller="Course" 
asp-route-num="@prevnum" 
class="btn btn-secondary">Previous</a>

<a asp-action="Index" 
asp-controller="Course" 
asp-route-num="@nextnum"
class="btn btn-secondary">Next</a> 

 