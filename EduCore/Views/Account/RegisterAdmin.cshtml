@model EduCore.ViewModels.RegisterDataViewModel

@{
    ViewData["Title"] = "Create Administrator";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="dash-card p-4 p-md-5 shadow-sm">
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="stat-icon primary mx-auto mb-3" style="width: 56px; height: 56px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Create Admin User</h3>
                    <p class="text-muted small mb-0">Provision an administrator account with privileged system access</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <!-- Form -->
                <form asp-action="RegisterAdmin" asp-controller="Account" method="post">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label small fw-semibold text-secondary">Username</label>
                        <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="admin@domain.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmedPassowrd" class="form-label small fw-semibold text-secondary">Confirm Password</label>
                            <input asp-for="ConfirmedPassowrd" type="password" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmedPassowrd" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label small fw-semibold text-secondary">Role</label>
                        <input asp-for="Role" class="form-control" placeholder="Admin" />
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
                        Create Administrator &rarr;
                    </button>
                </form>

                <div class="text-center pt-3 border-top">
                    <a asp-action="DashBoard" asp-controller="Admin" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                        &larr; Back to Admin Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
