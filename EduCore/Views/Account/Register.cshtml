@model EduCore.ViewModels.RegisterDataViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="dash-card p-4 p-md-5 shadow-sm">
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="stat-icon primary mx-auto mb-3" style="width: 56px; height: 56px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Create New Account</h3>
                    <p class="text-muted small mb-0">Register a new user identity in the EduCore system</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <!-- Form -->
                <form asp-action="Register" asp-controller="Account" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="id" class="form-label small fw-semibold text-secondary">User ID</label>
                            <input asp-for="id" class="form-control" placeholder="e.g. 101" />
                            <span asp-validation-for="id" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label small fw-semibold text-secondary">Username</label>
                            <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@domain.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Choose a password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmedPassowrd" class="form-label small fw-semibold text-secondary">Confirm Password</label>
                            <input asp-for="ConfirmedPassowrd" type="password" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmedPassowrd" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label small fw-semibold text-secondary">Assign Role</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">-- Select Role --</option>
                            @if (Model?.Roles != null)
                            {
                                foreach (var r in Model.Roles)
                                {
                                    <option value="@r.Name">@r.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
                        Create Account &rarr;
                    </button>
                </form>

                <!-- Footer link -->
                <div class="text-center pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a asp-action="Login" asp-controller="Account" class="fw-semibold text-primary text-decoration-none">Sign In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
