@model TraineeInfoViewModel
@{
    ViewData["Title"] = "Trainee Dashboard";
    ViewData["HideHero"] = true;
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="dashboard-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-role-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Trainee Academic Portal
                    </span>
                    <span class="text-white-50 small">&bull; Student Learning Record</span>
                </div>
                <h1 class="dashboard-banner-title">My Learning & Results Workspace</h1>
                <p class="dashboard-banner-sub">
                    View academic curriculum courses, inspect examination results for each enrolled course, and monitor your personal academic standing.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Course" asp-action="ShowAllCourses" class="btn btn-light fw-semibold px-3 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    Browse All Courses
                </a>
            </div>
        </div>
    </div>

    <!-- Trainee Info (His Info) & Trainee Abilities -->
    <!-- Trainee Info (His Info: id, name, email, address, department, gpa) -->
    <div class="row g-4 mb-4">
        <!-- Trainee Profile Card -->
        <div class="col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Trainee Profile
                        Trainee Information
                    </h5>
                    <span class="badge-soft badge-soft-info">Enrolled Student</span>
                </div>
                <div class="dash-card-body">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="stat-icon info mx-auto mb-2" style="width: 64px; height: 64px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <div class="stat-icon info mx-auto mb-2" style="width: 60px; height: 60px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">@(User.Identity?.Name ?? "Trainee")</h5>
                        <h5 class="fw-bold text-dark mb-0" id="traineeInfoName">@(User.Identity?.Name ?? "Trainee")</h5>
                        <p class="text-muted small mb-1">Registered Student</p>
                        <span class="badge-soft badge-soft-success">Status: In Good Standing</span>
                    </div>

                    <!-- Trainee Info Fields: id, name, email, address, department, gpa -->
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="fw-semibold text-dark small">Software Engineering</span>
                        <span class="text-muted small">Trainee ID:</span>
                        <span class="fw-semibold text-dark small" id="traineeId">@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "TRN-201")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Available Abilities:</span>
                        <span class="badge-soft badge-soft-primary small">View Courses &bull; View Results</span>
                        <span class="text-muted small">Full Name:</span>
                        <span class="fw-semibold text-dark small" id="traineeName">@(User.Identity?.Name ?? "Ahmed Mostafa")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Academic Standing:</span>
                        <span class="badge-soft badge-soft-success small">Active Progression</span>
                        <span class="text-muted small">Email:</span>
                        <span class="fw-semibold text-primary small text-break" id="traineeEmail">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? $"{User.Identity?.Name?.ToLower() ?? "trainee"}@educore.edu")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Address:</span>
                        <span class="fw-semibold text-dark small" id="traineeAddress">@(User.FindFirst("Address")?.Value ?? "Dokki, Giza")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="badge-soft badge-soft-primary small" id="traineeDepartment">Software Engineering</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Passing Threshold:</span>
                        <span class="badge-soft badge-soft-warning small">Min Degree Required</span>
                        <span class="text-muted small">Cumulative GPA:</span>
                        <span class="fw-bold text-success small" id="traineeGpa">3.85 / 4.0 (88.5%)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainee Abilities Hub: View Courses & View Results -->
        <div class="col-lg-8">
            <div class="row g-3 h-100">
                <!-- 1. View Courses -->
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div>
                                <p class="stat-label">View Courses</p>
                                <h3 class="stat-value text-primary">Courses</h3>
                            </div>
                            <div class="stat-icon primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            </div>
                        </div>
                        <div class="pt-2 border-top">
                            <span class="stat-desc d-block mb-3">Browse all available curriculum modules and details</span>
                            <a asp-controller="Course" asp-action="ShowAllCourses" class="btn btn-sm btn-primary w-100 fw-semibold">
                                Browse Available Courses &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. View Results -->
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div>
                                <p class="stat-label">View Results</p>
                                <h3 class="stat-value text-success">Results</h3>
                            </div>
                            <div class="stat-icon success">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                        </div>
                        <div class="pt-2 border-top">
                            <span class="stat-desc d-block mb-3">Inspect course grades, passing marks, and evaluations</span>
                            <a asp-controller="Trainee" asp-action="AllResults" asp-route-id="1" class="btn btn-sm btn-success w-100 fw-semibold">
                                View Detailed Results &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Results Section: Results for Each Course -->
    <div class="row g-4">
        <!-- Results For Each Course Table -->
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="dash-card-header flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon success" style="width: 38px; height: 38px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        </div>
                        <div>
                            <h5 class="dash-card-title mb-0">Examination Results For Each Course</h5>
                            <span class="text-muted small">Scores, minimum required degree, and passing status</span>
                        </div>
                    </div>
                    <a asp-controller="Trainee" asp-action="AllResults" asp-route-id="1" class="btn btn-sm btn-outline-success fw-semibold">
                        View All Results
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Course Title</th>
                                <th>Score / Degree</th>
                                <th>Passing Min</th>
                                <th>Evaluation Status</th>
                                <th style="width: 25%;">Score Bar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-dark">ASP.NET Core MVC & Razor Pages</td>
                                <td><span class="fw-bold text-success">85 / 100</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Passed (Successed)</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 85%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Entity Framework Core & SQL Database</td>
                                <td><span class="fw-bold text-success">92 / 100</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Passed (Successed)</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 92%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Object-Oriented Programming (C#)</td>
                                <td><span class="fw-bold text-success">78 / 100</span></td>
                                <td class="text-muted">50 pts</td>
                                <td><span class="badge-soft badge-soft-success">Passed (Successed)</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 78%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Web APIs & Client Integrations</td>
                                <td><span class="fw-bold text-success">80 / 100</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Passed (Successed)</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 80%;"></div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Side: View Courses Shortcut & Academic Summary -->
        <div class="col-lg-4">
            <!-- View Courses Panel -->
            <div class="dash-card mb-4">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        Course Catalog Access
                    </h5>
                </div>
                <div class="dash-card-body p-3">
                    <p class="text-muted small mb-3">Explore the full catalog of courses offered across all academic departments.</p>
                    <a asp-controller="Course" asp-action="ShowAllCourses" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                        View All Available Courses &rarr;
                    </a>
                </div>
            </div>

            <!-- Trainee Academic Status Card -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Academic Standing
                    </h5>
                </div>
                <div class="dash-card-body p-3">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Cumulative Average:</span>
                        <span class="fw-bold text-success small">83.75%</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Completed Courses:</span>
                        <span class="fw-semibold text-dark small">4 Courses</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Passing Status:</span>
                        <span class="badge-soft badge-soft-success small">All Courses Passed</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Academic Standing:</span>
                        <span class="badge-soft badge-soft-primary small">Good Standing</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
