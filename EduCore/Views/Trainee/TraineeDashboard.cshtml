@model TraineeInfoViewModel
@{
    ViewData["Title"] = "Trainee Dashboard";
    ViewData["HideHero"] = true;
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="dashboard-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-role-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Trainee Academic Portal
                    </span>
                    <span class="text-white-50 small">&bull; Student Learning Record</span>
                </div>
                <h1 class="dashboard-banner-title">My Learning & Results Workspace</h1>
                <p class="dashboard-banner-sub mb-0">
                    Personal trainee workspace: view your curriculum courses and inspect your examination results.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-light fw-semibold px-3 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        View Courses
                    </a>
                    <a asp-controller="Result" asp-action="ResultsForT" asp-route-Tid="@Model?.id" class="btn btn-outline-light fw-semibold px-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        View Results
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid: Trainee Info + 2 Functionalities (Courses & Results) -->
    <div class="row g-4">
        <!-- Trainee Profile Card (id, name, email, address, department, gpa) -->
        <div class="col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Trainee Information
                    </h5>
                </div>
                <div class="dash-card-body">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="stat-icon info mx-auto mb-2" style="width: 64px; height: 64px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <h5 class="fw-bold text-dark mb-0" id="traineeInfoName">@Model?.Name</h5>
                    </div>

                    <!-- Trainee Info Fields: id, name, email, address, department, gpa -->
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Trainee ID:</span>
                        <span class="fw-semibold text-dark small" id="traineeId">@Model?.id</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Full Name:</span>
                        <span class="fw-semibold text-dark small" id="traineeName">@Model?.Name</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Email:</span>
                        <span class="fw-semibold text-primary small text-break" id="traineeEmail">@Model?.Email</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Address:</span>
                        <span class="fw-semibold text-dark small" id="traineeAddress">@Model?.Address</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="badge-soft badge-soft-primary small" id="traineeDepartment">@Model?.Department</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Cumulative GPA:</span>
                        <span class="fw-bold text-success small" id="traineeGpa">@Model?.Grade</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainee's Exactly Two Functionalities: Courses & Results -->
        <div class="col-lg-8">
            <div class="d-flex flex-column gap-4">
                
                <!-- Functionality 1: See His Courses -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon primary" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">My Courses</h5>
                                <span class="text-muted small">Browse curriculum courses, hours, and department syllabus</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Explore academic courses across all departments. Check credit hours, minimum passing degrees, and faculty instructors.
                        </p>
                        <a asp-controller="Course" asp-action="Index" class="btn btn-primary fw-semibold px-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            View Courses
                        </a>
                    </div>
                </div>

                <!-- Functionality 2: See His Results -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon success" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">My Examination Results</h5>
                                <span class="text-muted small">View scores, degrees, and pass/fail status for each course</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Inspect your examination degrees, score achievements, and passing status for each of your enrolled courses.
                        </p>
                        <a asp-controller="Result" asp-action="ResultsForT" asp-route-Tid="@Model?.id" class="btn btn-success fw-semibold px-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            View My Results
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
