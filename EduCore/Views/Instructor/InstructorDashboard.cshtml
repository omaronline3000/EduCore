@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Instructor Dashboard</h2>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Assigned Courses</h6>
                    <h3 id="assignedCourses">--</h3>
                    <p class="text-muted small">Placeholder: number of courses assigned to instructor</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Active Trainees</h6>
                    <h3 id="activeTrainees">--</h3>
                    <p class="text-muted small">Placeholder: number of active trainees</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Pending Grades</h6>
                    <h3 id="pendingGrades">--</h3>
                    <p class="text-muted small">Placeholder: assignments needing grading</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">My Courses</div>
                <div class="card-body">
                    <ul id="myCourses" class="list-group"> 
                        <li class="list-group-item text-muted">Placeholder: course list (from backend)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">Recent Submissions</div>
                <div class="card-body">
                    <div id="recentSubmissions">
                        <p class="text-muted">Placeholder: recent submissions to grade (from backend)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">Announcements</div>
                <div class="card-body">
                    <div id="announcements">Placeholder: announcements (from backend)</div>
                </div>
            </div>
        </div>
    </div>
</div>
