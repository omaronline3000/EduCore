@model InstructorInfoViewModel
@{
    ViewData["Title"] = "Instructor Dashboard";
    ViewData["HideHero"] = true;
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="dashboard-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-role-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                        Instructor Portal
                    </span>
                    <span class="text-white-50 small">&bull; Teaching & Evaluation</span>
                </div>
                <h1 class="dashboard-banner-title">Faculty Instructor Workspace</h1>
                <p class="dashboard-banner-sub mb-0">
                    Teaching workspace: inspect enrolled trainees and submit or review student examination results.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Result" asp-action="AddResult" class="btn btn-light fw-semibold px-3 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    + Add New Result
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Grid: Instructor Info + Functional Buttons -->
    <div class="row g-4">
        <!-- Instructor Info Card (id, name, email, address, department, course) -->
        <div class="col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Instructor Information
                    </h5>
                </div>
                <div class="dash-card-body">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="stat-icon success mx-auto mb-2" style="width: 64px; height: 64px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                        </div>
                        <h5 class="fw-bold text-dark mb-0" id="instructorInfoName">@Model?.Name</h5>
                    </div>

                    <!-- Instructor Info Fields: id, name, email, address, department, course -->
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Instructor ID:</span>
                        <span class="fw-semibold text-dark small" id="instructorId">@Model?.Userid</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Full Name:</span>
                        <span class="fw-semibold text-dark small" id="instructorName">@Model?.Name</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Email:</span>
                        <span class="fw-semibold text-primary small text-break" id="instructorEmail">@Model?.Email</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Address:</span>
                        <span class="fw-semibold text-dark small" id="instructorAddress">@Model?.Address</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="fw-semibold text-dark small" id="instructorDepartment">@Model?.Department</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Assigned Course:</span>
                        <span class="fw-bold text-dark small" id="instructorCourse">@Model?.Course?.Name</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Instructor Functional Buttons & Modules -->
        <div class="col-lg-8">
            <div class="d-flex flex-column gap-4">

                <!-- 1. View Trainees -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon info" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">Enrolled Trainees</h5>
                                <span class="text-muted small">Inspect registered student roster and academic records</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Access the complete list of registered trainees, student contact details, departments, and cumulative academic standings.
                        </p>
                        <a asp-controller="Instructor" asp-action="GetTrainees" class="btn btn-info text-white fw-semibold px-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            View Trainees
                        </a>
                    </div>
                </div>

                <!-- 2. Course Results: Add Result & View Results (ResultsFor) -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon success" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">Course Examination Results</h5>
                                <span class="text-muted small">Manage and review student grades for your assigned course</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Submit a new trainee examination result or view all student results belonging to your assigned course.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Result" asp-action="AddResult" class="btn btn-success fw-semibold px-4">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Add New Result
                            </a>
                            <a asp-controller="Result" asp-action="ResultsForC" asp-route-Cid="@Model?.Course?.Id" class="btn btn-outline-success fw-semibold px-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                View Results
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
