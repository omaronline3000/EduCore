@model InstructorInfoViewModel
@{
    ViewData["Title"] = "Instructor Dashboard";
    ViewData["HideHero"] = true;
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="dashboard-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-role-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                        Instructor Portal
                    </span>
                    <span class="text-white-50 small">&bull; Teaching & Evaluation</span>
                </div>
                <h1 class="dashboard-banner-title">Faculty Instructor Workspace</h1>
                <p class="dashboard-banner-sub">
                    View curriculum courses, browse enrolled trainees, and submit student course examination results.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Result" asp-action="AddResult" class="btn btn-light fw-semibold px-3 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    + Add New Result
                </a>
            </div>
        </div>
    </div>

    <!-- Instructor Info (His Info) & Abilities Summary -->
    <!-- Instructor Info (His Info: id, name, email, address, department, course) -->
    <div class="row g-4 mb-4">
        <!-- Instructor Profile Card -->
        <div class="col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Instructor Profile
                        Instructor Information
                    </h5>
                    <span class="badge-soft badge-soft-success">Faculty</span>
                </div>
                <div class="dash-card-body">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="stat-icon success mx-auto mb-2" style="width: 64px; height: 64px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                        <div class="stat-icon success mx-auto mb-2" style="width: 60px; height: 60px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">@(User.Identity?.Name ?? "Instructor")</h5>
                        <h5 class="fw-bold text-dark mb-0" id="instructorInfoName">@(User.Identity?.Name ?? "Instructor")</h5>
                        <p class="text-muted small mb-1">Academic Faculty Member</p>
                        <span class="badge-soft badge-soft-primary">Status: Active Teaching</span>
                    </div>

                    <!-- Instructor Info Fields: id, name, email, address, department, course -->
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="fw-semibold text-dark small">Information Technology</span>
                        <span class="text-muted small">Instructor ID:</span>
                        <span class="fw-semibold text-dark small" id="instructorId">@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "INS-101")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Assigned Course:</span>
                        <span class="fw-semibold text-primary small">ASP.NET Core MVC</span>
                        <span class="text-muted small">Full Name:</span>
                        <span class="fw-semibold text-dark small" id="instructorName">@(User.Identity?.Name ?? "Dr. Mohamed Ali")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Available Abilities:</span>
                        <span class="badge-soft badge-soft-info small">View Courses &bull; View Trainees &bull; Add Results</span>
                        <span class="text-muted small">Email:</span>
                        <span class="fw-semibold text-primary small text-break" id="instructorEmail">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? $"{User.Identity?.Name?.ToLower() ?? "instructor"}@educore.edu")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Address:</span>
                        <span class="fw-semibold text-dark small" id="instructorAddress">@(User.FindFirst("Address")?.Value ?? "Nasr City, Cairo")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Department:</span>
                        <span class="badge-soft badge-soft-primary small" id="instructorDepartment">Information Technology</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Evaluation Role:</span>
                        <span class="badge-soft badge-soft-success small">Grade Submissions</span>
                        <span class="text-muted small">Assigned Course:</span>
                        <span class="fw-bold text-dark small" id="instructorCourse">ASP.NET Core MVC</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Instructor Abilities Action Hub -->
        <div class="col-lg-8">
            <div class="row g-3 h-100">
                <!-- 1. View Courses -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div>
                                <p class="stat-label">View Courses</p>
                                <h3 class="stat-value text-primary">Courses</h3>
                            </div>
                            <div class="stat-icon primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            </div>
                        </div>
                        <div class="pt-2 border-top">
                            <span class="stat-desc d-block mb-2">Browse the curriculum offerings</span>
                            <a asp-controller="Course" asp-action="Index" class="btn btn-sm btn-primary w-100 fw-semibold">
                                View Courses &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. View Trainees -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div>
                                <p class="stat-label">View Trainees</p>
                                <h3 class="stat-value text-info">Trainees</h3>
                            </div>
                            <div class="stat-icon info">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                            </div>
                        </div>
                        <div class="pt-2 border-top">
                            <span class="stat-desc d-block mb-2">Browse student roster & profiles</span>
                            <a asp-controller="Trainee" asp-action="Index" class="btn btn-sm btn-info text-white w-100 fw-semibold">
                                View Trainees &rarr;
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 3. Add Results -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div>
                                <p class="stat-label">Add Results</p>
                                <h3 class="stat-value text-success">Results</h3>
                            </div>
                            <div class="stat-icon success">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </div>
                        </div>
                        <div class="pt-2 border-top">
                            <span class="stat-desc d-block mb-2">Submit and evaluate exams</span>
                            <a asp-controller="Result" asp-action="AddResult" class="btn btn-sm btn-success w-100 fw-semibold">
                                + Add Result &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Instructor Main Panels: View Trainees & Add Results -->
    <div class="row g-4">
        <!-- Add Results & Trainee Evaluation Table -->
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="dash-card-header flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon success" style="width: 38px; height: 38px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        </div>
                        <div>
                            <h5 class="dash-card-title mb-0">Trainee Course Results & Evaluation</h5>
                            <span class="text-muted small">Input results and review academic standing</span>
                        </div>
                    </div>
                    <a asp-controller="Result" asp-action="AddResult" class="btn btn-sm btn-success fw-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Add Trainee Result
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Trainee Name</th>
                                <th>Score / Degree</th>
                                <th>Required Min</th>
                                <th>Status</th>
                                <th style="width: 25%;">Achievement</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-dark">Ahmed Mostafa</td>
                                <td><span class="fw-bold text-success">88 pts</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Successed</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 88%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Sara Hassan</td>
                                <td><span class="fw-bold text-success">94 pts</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Successed</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 94%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Karim Adel</td>
                                <td><span class="fw-bold text-danger">52 pts</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-danger">Failed</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-danger" style="width: 52%;"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-dark">Nouran Mahmoud</td>
                                <td><span class="fw-bold text-success">78 pts</span></td>
                                <td class="text-muted">60 pts</td>
                                <td><span class="badge-soft badge-soft-success">Successed</span></td>
                                <td>
                                    <div class="dash-progress">
                                        <div class="dash-progress-bar bg-success" style="width: 78%;"></div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Side: View Courses & Course Benchmark Specs -->
        <div class="col-lg-4">
            <!-- View Courses Card -->
            <div class="dash-card mb-4">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        Assigned Course Details
                    </h5>
                </div>
                <div class="dash-card-body p-3">
                    <h6 class="fw-bold text-dark mb-1">ASP.NET Core MVC & Web APIs</h6>
                    <p class="text-muted small mb-3">Active instruction module for the current semester.</p>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Credit Hours:</span>
                        <span class="fw-semibold text-dark small">40 Hours</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Maximum Degree:</span>
                        <span class="fw-semibold text-dark small">100 Points</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Minimum Passing:</span>
                        <span class="badge-soft badge-soft-warning small">60 Points</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="text-muted small">Department:</span>
                        <span class="badge-soft badge-soft-primary small">Information Technology</span>
                    </div>

                    <div class="mt-3">
                        <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                            Browse All Courses &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- View Trainees Card -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-info"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        Trainees Directory
                    </h5>
                </div>
                <div class="dash-card-body p-3">
                    <p class="text-muted small mb-3">View and inspect profiles of enrolled trainees attending your courses.</p>
                    <a asp-controller="Trainee" asp-action="Index" class="btn btn-outline-info btn-sm w-100 fw-semibold">
                        View Trainees Directory &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
