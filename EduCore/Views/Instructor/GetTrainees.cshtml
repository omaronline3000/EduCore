@model List<Trainee>?
@{
    ViewData["Title"] = "Enrolled Trainees";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-soft badge-soft-info">Students</span>
                <span class="text-muted small">&bull; Course Roster</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Enrolled Trainees</h2>
            <p class="text-muted small mb-0">Class roster of enrolled students and academic performance records</p>
        </div>
        <div>
            <a asp-controller="Instructor" asp-action="DashBoard" class="btn btn-outline-secondary rounded-pill px-3">
                &larr; Instructor Dashboard
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="dash-card">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 70px;">ID</th>
                        <th>Trainee Name</th>
                        <th>Address</th>
                        <th class="text-center">Academic Grade / GPA</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm bg-light text-info fw-bold" style="width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; border: 1px solid #e2e8f0;">
                                            @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-bold text-dark">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(item.Address ?? "N/A")</td>
                                <td class="text-center">
                                    <span class="badge-soft badge-soft-success fw-bold">@item.Grade</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.department?.Name))
                                    {
                                        <span class="badge-soft badge-soft-primary">@item.department.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>None</em></span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <p class="mb-0">No trainees found in this roster.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
