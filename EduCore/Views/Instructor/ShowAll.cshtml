@model List<Instructor>

<br /><br />
<form method="get" asp-action="Search" asp-controller="Instructor">
    <label>Search For Instructors</label>
    <input id="search" name="search" placeholder="Instructor Name"/>
    <input type="submit" value="Searh"/>
</form>


<a asp-action="Add" asp-controller="Instructor" class="btn btn-dark">Add Instructor</a>

 <table class="table table-bordered table-hover">

        @foreach (var item in Model)
        {
            <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Address</td>
            <td>@item.Salary</td>
            <td>@item.department?.Name</td>
            <td>@item.course?.Name</td>
            <td><a class= "btn btn-primary" asp-action="details" asp-controller="Instructor" asp-route-id="@item.Id">Details</a></td>
            </tr>
        }
 </table>
