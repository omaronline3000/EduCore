@model List<Instructor>
@{
    ViewData["Title"] = "Instructors Directory";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-soft badge-soft-success">Faculty</span>
                <span class="text-muted small">&bull; Teaching Staff</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Instructors Directory</h2>
            <p class="text-muted small mb-0">Manage university teaching faculty, departments, and course allocations</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Add" asp-controller="Instructor" class="btn btn-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Add Instructor</span>
            </a>
            <a asp-action="DashBoard" asp-controller="Admin" class="btn btn-outline-secondary rounded-pill px-3">
                &larr; Admin Dashboard
            </a>
        </div>
    </div>

    <!-- Search Bar Card -->
    <div class="dash-card p-3 mb-4">
        <form method="get" asp-action="Search" asp-controller="Instructor" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input id="search" name="search" class="form-control border-start-0 ps-0" placeholder="Search instructors by name..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold">
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <div class="dash-card">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 70px;">ID</th>
                        <th>Instructor Name</th>
                        <th>Address</th>
                        <th>Salary</th>
                        <th>Department</th>
                        <th>Assigned Course</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm bg-light text-primary fw-bold" style="width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; border: 1px solid #e2e8f0;">
                                            @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-bold text-dark">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(item.Address ?? "N/A")</td>
                                <td>
                                    <span class="fw-semibold text-dark">$@item.Salary.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.department?.Name))
                                    {
                                        <span class="badge-soft badge-soft-info">@item.department.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>None</em></span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.course?.Name))
                                    {
                                        <span class="badge-soft badge-soft-success">@item.course.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Unassigned</em></span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="details"
                                       asp-controller="Instructor"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                        View Details &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <p class="mb-0">No instructors found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
