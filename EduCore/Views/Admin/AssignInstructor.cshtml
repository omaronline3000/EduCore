@model EduCore.ViewModels.AssignInstructorViewModel
@{
    ViewData["Title"] = "Assign Instructor to Course";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="dash-card p-4 p-md-5 shadow-sm">
                <!-- Header -->
                <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-4">
                    <div class="stat-icon primary" style="width: 50px; height: 50px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Assign Instructor</h4>
                        <p class="text-muted small mb-0">Select a course and assign a qualified instructor</p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <form asp-action="AssignInstructor" asp-controller="Admin" method="post">
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label small fw-semibold text-secondary">Course</label>
                        <select asp-for="CourseId" class="form-select" asp-items='new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.courses, "Id", "Name")'>
                            <option value="">-- Select Course --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="InstructorId" class="form-label small fw-semibold text-secondary">Instructor</label>
                        <select asp-for="InstructorId" class="form-select" asp-items='new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.instructors, "Id", "Name")'>
                            <option value="">-- Select Instructor --</option>
                        </select>
                        <span asp-validation-for="InstructorId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                        <a asp-action="DashBoard" asp-controller="Admin" class="btn btn-outline-secondary px-4 rounded-pill">
                            &larr; Admin Dashboard
                        </a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
                            Assign Instructor &rarr;
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
