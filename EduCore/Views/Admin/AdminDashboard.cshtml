@model AdminInfoViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["HideHero"] = true;
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="dashboard-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-role-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Administrator
                    </span>
                    <span class="text-white-50 small">&bull; Full System Control</span>
                </div>
                <h1 class="dashboard-banner-title">Admin Management Console</h1>
                <p class="dashboard-banner-sub mb-0">
                    Full administrative privileges: add, delete, and view instructors, courses, and trainees, plus assign instructors to courses.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light fw-semibold px-3 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                        Register User
                    </a>
                    <a asp-controller="Role" asp-action="Add" class="btn btn-outline-light fw-semibold px-3">
                        + New Role
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid: Admin Info + Functional Modules -->
    <div class="row g-4">
        <!-- Admin Info Card (id, name, email) -->
        <div class="col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h5 class="dash-card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Admin Information
                    </h5>
                </div>
                <div class="dash-card-body">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="stat-icon primary mx-auto mb-2" style="width: 64px; height: 64px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h5 class="fw-bold text-dark mb-0" id="adminInfoName">@Model?.Name</h5>
                    </div>

                    <!-- Admin Info Fields: id, name, email -->
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Admin ID:</span>
                        <span class="fw-semibold text-dark small" id="adminId">@Model?.Userid</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Full Name:</span>
                        <span class="fw-semibold text-dark small" id="adminName">@Model?.Name</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted small">Email Address:</span>
                        <span class="fw-semibold text-primary small text-break" id="adminEmail">@Model?.Email</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Functional Buttons & Modules -->
        <div class="col-lg-8">
            <div class="d-flex flex-column gap-4">
                
                <!-- 1. Courses Functionalities: View / Add / Assign / Delete -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon primary" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">Courses Management</h5>
                                <span class="text-muted small">View, add, delete courses, and assign instructors</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Full control over academic courses: view the curriculum catalog, create new courses, assign faculty instructors, or remove courses.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Course" asp-action="Index" class="btn btn-primary fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                View Courses
                            </a>
                            <a asp-controller="Course" asp-action="Add" class="btn btn-outline-primary fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Add Course
                            </a>
                            <a asp-controller="Admin" asp-action="AssignInstructor" class="btn btn-light border fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                                Assign Instructor
                            </a>
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#deleteCourseModal">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                Delete Course
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. Instructors Functionalities: View / Add / Delete -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon success" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">Instructors Management</h5>
                                <span class="text-muted small">View, add, and delete faculty members</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Full faculty management: browse all teaching instructors, register new instructors, or remove instructor profiles.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Instructor" asp-action="Index" class="btn btn-success fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                View Instructors
                            </a>
                            <a asp-controller="Instructor" asp-action="Add" class="btn btn-outline-success fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Add Instructor
                            </a>
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#deleteInstructorModal">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                Delete Instructor
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. Trainees Functionalities: View / Add / Delete -->
                <div class="dash-card">
                    <div class="dash-card-header flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon info" style="width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <div>
                                <h5 class="dash-card-title mb-0">Trainees Management</h5>
                                <span class="text-muted small">View, enroll, and delete trainee student records</span>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <p class="text-muted small mb-3">
                            Full student management: browse all registered trainees across departments, register new trainees, or delete trainee accounts.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Trainee" asp-action="Index" class="btn btn-info text-white fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                View Trainees
                            </a>
                            <a asp-controller="Trainee" asp-action="Add" class="btn btn-outline-info fw-semibold px-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Add Trainee
                            </a>
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#deleteTraineeModal">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                Delete Trainee
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal: Delete Course -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-labelledby="deleteCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteCourseModalLabel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Delete Course
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="get" asp-controller="Course" asp-action="Delete" onsubmit="return confirm('Are you sure you want to permanently delete this course?');">
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Enter the Course ID to remove it from the system curriculum.
                    </p>
                    <label class="form-label fw-semibold small">Course ID:</label>
                    <input type="number" name="id" class="form-control" placeholder="Enter Course ID" required />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">Delete Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Instructor -->
<div class="modal fade" id="deleteInstructorModal" tabindex="-1" aria-labelledby="deleteInstructorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteInstructorModalLabel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Delete Instructor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="get" asp-controller="Instructor" asp-action="Delete" onsubmit="return confirm('Are you sure you want to permanently delete this instructor?');">
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Enter the Instructor ID to remove this faculty instructor record.
                    </p>
                    <label class="form-label fw-semibold small">Instructor ID:</label>
                    <input type="number" name="id" class="form-control" placeholder="Enter Instructor ID" required />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">Delete Instructor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Trainee -->
<div class="modal fade" id="deleteTraineeModal" tabindex="-1" aria-labelledby="deleteTraineeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteTraineeModalLabel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Delete Trainee
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="get" asp-controller="Trainee" asp-action="Delete" onsubmit="return confirm('Are you sure you want to permanently delete this trainee?');">
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Enter the Trainee ID to remove this student record from the system.
                    </p>
                    <label class="form-label fw-semibold small">Trainee ID:</label>
                    <input type="number" name="id" class="form-control" placeholder="Enter Trainee ID" required />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">Delete Trainee</button>
                </div>
            </form>
        </div>
    </div>
</div>
