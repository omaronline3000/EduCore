@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Users</h6>
                    <h3 id="totalUsers">--</h3>
                    <p class="text-muted small">Placeholder: total users count (from backend)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Courses</h6>
                    <h3 id="totalCourses">--</h3>
                    <p class="text-muted small">Placeholder: total courses count (from backend)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Active Instructors</h6>
                    <h3 id="activeInstructors">--</h3>
                    <p class="text-muted small">Placeholder: active instructors count (from backend)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Pending Approvals</h6>
                    <h3 id="pendingApprovals">--</h3>
                    <p class="text-muted small">Placeholder: pending approval count (from backend)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">Recent Activities</div>
                <div class="card-body">
                    <div id="recentActivities"> <!-- Placeholder list to be filled by backend -->
                        <p class="text-muted">Placeholder: list of recent activities (from backend)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">Quick Actions</div>
                <div class="card-body d-flex flex-column">
                    <button class="btn btn-primary mb-2">Create Course</button>
                    <button class="btn btn-outline-secondary mb-2">Manage Roles</button>
                    <button class="btn btn-outline-danger">View Reports</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">Analytics (Placeholder)</div>
                <div class="card-body">
                    <div id="adminChart" style="height:280px; display:flex; align-items:center; justify-content:center; border:1px dashed #ddd;">
                        <span class="text-muted">Placeholder for analytics chart (inject data from backend)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
