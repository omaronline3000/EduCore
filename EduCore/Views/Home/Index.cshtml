@{
    ViewData["Title"] = "EduCore - Learning Management System";
}

<div class="container py-5">
    <!-- Platform Introduction -->
    <div class="text-center py-4 mb-5">
        <span class="badge-soft badge-soft-primary px-3 py-1 mb-3 fw-semibold">Learning Management System</span>
        <h1 class="display-5 fw-bold text-dark mb-3">Welcome to EduCore</h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">
            A simple and centralized platform designed to organize academic courses, coordinate instructors, and record student results.
        </p>
    </div>

    <!-- Roles Overview -->
    <div class="row g-4">
        <!-- Admin -->
        <div class="col-md-4">
            <div class="dash-card h-100 p-4 text-center">
                <div class="stat-icon primary mx-auto mb-3" style="width: 52px; height: 52px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h4 class="fw-bold text-dark mb-2">Admin</h4>
                <p class="text-muted small mb-0">
                    Manages courses, instructors, and trainees, and assigns instructors to courses.
                </p>
            </div>
        </div>

        <!-- Instructor -->
        <div class="col-md-4">
            <div class="dash-card h-100 p-4 text-center">
                <div class="stat-icon success mx-auto mb-3" style="width: 52px; height: 52px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                </div>
                <h4 class="fw-bold text-dark mb-2">Instructor</h4>
                <p class="text-muted small mb-0">
                    Views assigned courses and enrolled trainees, and records examination results.
                </p>
            </div>
        </div>

        <!-- Trainee -->
        <div class="col-md-4">
            <div class="dash-card h-100 p-4 text-center">
                <div class="stat-icon info mx-auto mb-3" style="width: 52px; height: 52px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <h4 class="fw-bold text-dark mb-2">Trainee</h4>
                <p class="text-muted small mb-0">
                    Views enrolled courses, credit hours, and examination results for each course.
                </p>
            </div>
        </div>
    </div>
</div>
